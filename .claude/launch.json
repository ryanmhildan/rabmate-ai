{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "services/api/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "services/api",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "web",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "Set-Location apps/web; $env:NEXT_TELEMETRY_DISABLED='1'; npm run dev"
      ],
      "port": 3000
    },
    {
      "name": "hermes-stub",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "Set-Location services/api; .venv/Scripts/python.exe -m tests.hermes_stub --port 8642 --key stub-kunci-lokal"
      ],
      "port": 8642,
      "url": "http://127.0.0.1:8642"
    },
    {
      "name": "api-ai-stub",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:AI_ENABLED='true'; $env:HERMES_API_KEY='stub-kunci-lokal'; services/api/.venv/Scripts/python.exe -m uvicorn app.main:app --app-dir services/api --host 127.0.0.1 --port 8000"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    }
  ]
}
