# RABmate AI — contoh konfigurasi lokal.
# Salin menjadi `.env` (sudah di-.gitignore) lalu ganti nilai placeholder.
#   PowerShell:  Copy-Item .env.example .env
# Jangan pernah mengisi secrets asli di file ini.

# ---------------------------------------------------------------- Aplikasi
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# true = log JSON (disarankan di produksi)
LOG_JSON=false
# OpenAPI di /api/v1/docs (selalu mati di production)
ENABLE_API_DOCS=true
TIMEZONE=Asia/Jakarta
DEFAULT_CURRENCY=IDR

# Kunci acak untuk penandatanganan (CSRF, dsb). Wajib >= 32 karakter di production.
#   PowerShell:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-.env

# Origin browser yang diizinkan (dipisah koma, tanpa wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- PostgreSQL (docker compose)
POSTGRES_USER=rabmate
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=rabmate
POSTGRES_PORT=5432

# URL dipakai oleh API & Alembic. Samakan user/password dengan nilai di atas.
# Pakai 127.0.0.1, bukan localhost: di Windows localhost → ::1 dulu dan koneksi tertahan ±8 detik.
DATABASE_URL=postgresql+psycopg://rabmate:change-me-local-db-password@127.0.0.1:5432/rabmate
# Database khusus tes; nama WAJIB berakhiran _test (tes menolak nama lain).
TEST_DATABASE_URL=postgresql+psycopg://rabmate:change-me-local-db-password@127.0.0.1:5432/rabmate_test

# ---------------------------------------------------------------- Pencarian harga eksternal
# Belum ada provider; "none" = fitur menampilkan status "belum dikonfigurasi" (tanpa data palsu).
PRICE_SEARCH_PROVIDER=none

# ---------------------------------------------------------------- AI lokal (Hermes Agent) — Fase 8
# Tidak ada fallback ke penyedia cloud. Biarkan false sampai Hermes terpasang & dikonfigurasi
# (docs/LOCAL_DEVELOPMENT.md §7). Fitur non-AI tetap berjalan tanpa AI.
AI_ENABLED=false
# Wajib alamat lokal (127.0.0.1/localhost); alamat lain ditolak saat start.
HERMES_BASE_URL=http://127.0.0.1:8642
# Sama dengan API_SERVER_KEY di profil Hermes RABmate (jangan dikomit).
HERMES_API_KEY=
# Nama "model" yang diekspos API server Hermes (API_SERVER_MODEL_NAME / nama profil).
HERMES_MODEL=rabmate
# Toolset Hermes yang boleh aktif (dipisah koma). Kosong = tidak ada; toolset lain yang aktif
# (terminal, file, web, ...) membuat adapter menolak berjalan.
HERMES_ALLOWED_TOOLSETS=
AI_REQUEST_TIMEOUT_SECONDS=120
# Percobaan ulang terbatas (gangguan sementara / satu kali perbaikan format jawaban): 0–2.
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=20000
AI_MAX_OUTPUT_CHARS=60000

# ---------------------------------------------------------------- Dokumen sumber & OCR — Fase 9
# File sumber (PDF/XLSX/CSV/TXT/PNG/JPEG) untuk ekstraksi item: ukuran maks. dan halaman dibaca.
UPLOAD_MAX_MB=10
INTAKE_MAX_PAGES=50
# Dokumen panjang diproses per bagian: ukuran satu bagian (karakter) dan jumlah bagian maksimal.
AI_CHUNK_CHARS=12000
AI_MAX_CHUNKS=6
# OCR memakai Tesseract lokal bila terpasang (opsional; lihat docs/LOCAL_DEVELOPMENT.md §7.6).
# Tanpa Tesseract, halaman hasil scan/gambar dilewati dengan peringatan.
OCR_ENABLED=true
TESSERACT_CMD=
OCR_LANGUAGES=ind+eng
OCR_TIMEOUT_SECONDS=60
OCR_MAX_PAGES=20
